{
  "configurations": [
    {
      "name": "Windows",
      "configurationProvider": "ms-vscode.cmake-tools",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/src",
        "${workspaceFolder}/build/debug/generated/include",
        "${workspaceFolder}/build/release/generated/include",
        "${workspaceFolder}/build/shared/generated/include",
        "${workspaceFolder}/build/asan/generated/include",
        "${workspaceFolder}/build/coverage/generated/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/build/debug/generated/include",
          "${workspaceFolder}/build/release/generated/include",
          "${workspaceFolder}/build/shared/generated/include",
          "${workspaceFolder}/build/asan/generated/include",
          "${workspaceFolder}/build/coverage/generated/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "WIN32",
        "_WINDOWS",
        "_DEBUG"
      ],
      "cStandard": "c11",
      "intelliSenseMode": "windows-msvc-x64"
    },
    {
      "name": "Linux",
