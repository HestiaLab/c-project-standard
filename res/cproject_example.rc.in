#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @CPROJECT_VERSION_MAJOR@,@CPROJECT_VERSION_MINOR@,@CPROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @CPROJECT_VERSION_MAJOR@,@CPROJECT_VERSION_MINOR@,@CPROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "CProjectStandard contributors"
            VALUE "FileDescription", "Project Setup Wizard"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "cproject"
            VALUE "LegalCopyright", "Copyright (c) 2026 CProjectStandard contributors"
            VALUE "OriginalFilename", "cproject.exe"
            VALUE "ProductName", "CProjectStandard"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
