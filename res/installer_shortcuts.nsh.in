; CProjectStandard installer helper macros.
; Included via CPACK_NSIS_EXTRA_INSTALL_COMMANDS via !insertmacro.
; Reads USERPROFILE to find the real user desktop (Program Files has space;
; $DESKTOP resolves to Public Desktop under admin install).

Function CreateUserDesktopShortcut
    ReadEnvStr $0 USERPROFILE
    StrCmp $0 "" done
    CreateShortCut "$0\Desktop\CProjectStandard.lnk" "$INSTDIR\bin\run-wizard.bat"
    done:
FunctionEnd

!macro INSTALLER_SHORTCUTS
    Call CreateUserDesktopShortcut
!macroend